<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:baselineAligned="false"
  android:orientation="horizontal"
  android:layout_marginStart="15dp"
  android:layout_marginEnd="15dp"
  android:layout_gravity="bottom">
  <!-- Left column for landscape mode -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="0.7"
    android:orientation="vertical">
    <androidx.constraintlayout.utils.widget.ImageFilterView
      android:id="@+id/screenshot_preview"
      android:layout_width="match_parent"
      android:layout_height="220dp"
      android:layout_marginEnd="5dp"
      android:adjustViewBounds="true"
      android:scaleType="centerInside" />
  </LinearLayout>
  <!-- Right column for landscape mode -->
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_weight="1.3"
    android:orientation="vertical">
    <LinearLayout
      android:id="@+id/action_buttons"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginHorizontal="20dp"
      android:gravity="center"
      android:orientation="horizontal">
      <io.github.lumiagg.gestureevo.inspire.ui.InspireActionButtonsRow
        android:id="@+id/image_action_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:gravity="center"
        android:orientation="horizontal">
        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="0dp"
          android:layout_height="35dp"
          android:layout_marginHorizontal="4dp"
          android:layout_weight="1"
          app:cardElevation="0dp">
          <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/scanQR"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/baseline_qr_code_scanner_24"
            android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="0dp"
          android:layout_height="35dp"
          android:layout_marginHorizontal="4dp"
          android:layout_weight="1"
          app:cardElevation="0dp">
          <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/btn_share"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/ic_baseline_share_24"
            android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="0dp"
          android:layout_height="35dp"
          android:layout_marginHorizontal="4dp"
          android:layout_weight="1"
          app:cardElevation="0dp">
          <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/btn_pin_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/baseline_push_pin_24"
            android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
          style="@style/Widget.Material3.CardView.Filled"
          android:layout_width="0dp"
          android:layout_height="35dp"
          android:layout_marginHorizontal="4dp"
          android:layout_weight="1"
          app:cardElevation="0dp">
          <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/btn_save_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackground"
            android:padding="7dp"
            android:src="@drawable/baseline_save_24"
            android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
      </io.github.lumiagg.gestureevo.inspire.ui.InspireActionButtonsRow>
      <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        app:cardElevation="0dp">
        <androidx.constraintlayout.utils.widget.ImageFilterView
          android:id="@+id/openUrl"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="?attr/selectableItemBackground"
          android:padding="7dp"
          android:src="@drawable/ic_baseline_insert_link_24"
          android:tint="?attr/colorPrimary" />
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        app:cardElevation="0dp">
        <androidx.constraintlayout.utils.widget.ImageFilterView
          android:id="@+id/btn_reselect"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="?attr/selectableItemBackground"
          android:padding="7dp"
          android:src="@drawable/baseline_refresh_24"
          android:tint="?attr/colorPrimary" />
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="2"
        app:cardElevation="0dp">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:gravity="center"
          android:orientation="horizontal"
          android:padding="2dp">
          <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_mode_ocr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/inspire_mode_selector_left"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/inspire_mode_ocr"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/inspire_mode_selector_text" />
          <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/btn_mode_accessibility"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/inspire_mode_selector_right"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="@string/inspire_mode_accessibility"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/inspire_mode_selector_text" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:layout_marginHorizontal="4dp"
        android:layout_weight="1"
        app:cardElevation="0dp">
        <androidx.constraintlayout.utils.widget.ImageFilterView
          android:id="@+id/selectAll"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="?attr/selectableItemBackground"
          android:padding="7dp"
          android:src="@drawable/baseline_select_all_24"
          android:tint="?attr/colorPrimary" />
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
      android:id="@+id/bigBangLayoutNestedScroll"
      android:layout_width="match_parent"
      android:layout_height="220dp"
      android:layout_marginTop="10dp"
      android:scrollbars="vertical">
      <io.github.lumiagg.gestureevo.inspire.ui.BigBangView
        android:id="@+id/bigBangLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:importantForAccessibility="no" />
    </androidx.core.widget.NestedScrollView>
  </LinearLayout>
</LinearLayout>
