<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingVertical="12dp"
        android:text="@string/icon_select_title"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
        android:id="@+id/select_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:settingsRowTitle="@string/icon_select_gallery" />

    <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
        android:id="@+id/select_app_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:settingsRowTitle="@string/icon_select_app_icon" />

    <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
        android:id="@+id/select_text_icon"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:settingsRowTitle="@string/icon_select_text_icon" />

</LinearLayout>
