<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_bar_height">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/toolbar_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:toolbarId="@+id/toolbar">
      <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/search_engine_settings_title" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:id="@+id/searchEngineScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="@dimen/settings_card_spacing"
      android:paddingVertical="16dp">
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/previewSortCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/search_engine_settings_preview_mode"
        app:settingsCardSummary="@string/search_engine_settings_preview_mode_summary"
        app:settingsCardExpandable="false" />
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/displaySettingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/search_engine_settings_display_title"
        app:settingsCardSummary="@string/search_engine_settings_display_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/search_engine_settings_display_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="8dp"
            android:baselineAligned="false">
            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_engine_settings_row_count_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/search_engine_settings_row_count_description"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:baselineAligned="false">
              <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decrease_rows"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/remove_24px"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
              <TextView
                android:id="@+id/tv_row_count"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/search_engine_settings_row_count_default"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />
              <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_increase_rows"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/baseline_add_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:baselineAligned="false">
            <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical">
              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/search_engine_settings_column_count_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp" />
              <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/search_engine_settings_column_count_description"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:baselineAligned="false">
              <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decrease_columns"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/remove_24px"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
              <TextView
                android:id="@+id/tv_column_count"
                android:layout_width="48dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/search_engine_settings_column_count_default"
                android:textColor="?attr/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />
              <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_increase_columns"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:icon="@drawable/baseline_add_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />
            </LinearLayout>
          </LinearLayout>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_show_labels">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/engine_label_visbility_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_bottom_layout">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_bottom_layout_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_result_double_column">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/result_double_column_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_keyboard_follow_animation">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/keyboard_follow_animation_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_image_badge">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/image_engine_badge_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/functionSettingsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/search_engine_settings_features_title"
        app:settingsCardSummary="@string/search_engine_settings_features_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/search_engine_settings_features_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_show_clipboard_content">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_clipboard_content_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_search_history">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_history_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_search_contacts">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_contact_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_search_settings">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_settings_shortcuts_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_enter_first_result">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_enter_first_result_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_keep_last_result">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_keep_last_result_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/defaultSearchPageCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardExpanded="false"
        app:settingsCardSummary="@string/search_engine_settings_startup_description"
        app:settingsCardTitle="@string/search_engine_settings_startup_title">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@string/search_engine_settings_startup_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_default_search_page">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/defaultSearchPageSwitch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/importExportCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/search_engine_settings_transfer_title"
        app:settingsCardSummary="@string/search_engine_settings_transfer_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_engine_settings_transfer_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/search_engine_settings_transfer_description"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_import"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_import"
            app:settingsRowSummary="@string/search_engine_settings_import_summary" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/search_engine_settings_export"
            app:settingsRowSummary="@string/search_engine_settings_export_summary" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/engineListCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/search_engine_settings_engine_list_title"
        app:settingsCardSummary="@string/search_engine_settings_engine_list_description"
        app:settingsCardExpanded="false">
        <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">
          <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/engine_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingVertical="8dp"
            tools:itemCount="5"
            tools:listitem="@layout/search_engine_manage_item" />
          <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="48dp"
            android:visibility="gone">
            <ImageView
              android:layout_width="64dp"
              android:layout_height="64dp"
              android:alpha="0.5"
              android:src="@drawable/search_24px"
              app:tint="?attr/colorOnSurfaceVariant"
              android:contentDescription="@null"
              android:importantForAccessibility="no" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="16dp"
              android:text="@string/search_engine_settings_empty_title"
              android:textColor="?attr/colorOnSurfaceVariant"
              android:textSize="16sp" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="@string/search_engine_settings_empty_description"
              android:textColor="?attr/colorOnSurfaceVariant"
              android:textSize="14sp" />
          </LinearLayout>
          <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
        </FrameLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/hiddenResultsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:settingsCardTitle="@string/hidden_search_results_title"
        app:settingsCardSummary="@string/hidden_search_results_summary"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/hidden_result_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingVertical="8dp"
            tools:listitem="@layout/hidden_search_result_item" />
          <TextView
            android:id="@+id/hidden_results_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/hidden_search_results_empty"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
  <com.google.android.material.floatingactionbutton.FloatingActionButton
    android:id="@+id/fab_add"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:layout_margin="16dp"
    android:contentDescription="@string/search_engine_settings_add_engine"
    app:srcCompat="@drawable/baseline_add_24" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
