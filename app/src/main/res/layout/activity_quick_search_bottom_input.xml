<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/searchContainer"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@android:color/transparent"
  tools:context=".search.QuickSearchActivity">
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/top_search_card"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="@dimen/quick_search_card_margin_top"
    android:layout_marginBottom="@dimen/quick_search_card_margin_bottom"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:layout_constrainedHeight="true"
    app:layout_constraintWidth_max="@dimen/quick_search_card_max_width"
    app:layout_constraintHorizontal_bias="0.5"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintVertical_bias="1"
    app:strokeColor="?attr/colorOutlineVariant">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <FrameLayout
        android:id="@+id/drag_bar_container"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:contentDescription="@string/quick_search_drag_hint"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:visibility="gone">
        <View
          android:id="@+id/drag_bar"
          android:layout_width="@dimen/quick_search_drag_bar_width"
          android:layout_height="@dimen/quick_search_drag_bar_height"
          android:layout_gravity="center"
          android:background="@drawable/quick_search_drag_bar" />
      </FrameLayout>
      <FrameLayout
        android:id="@+id/result_panel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone">
        <io.github.lumiagg.gestureevo.search.SearchResultRecyclerView
          android:id="@+id/result_recycler"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="true"
          android:overScrollMode="never"
          android:paddingTop="0dp"
          android:paddingBottom="2dp"
          tools:itemCount="4" />
        <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_gravity="bottom"
          android:layout_marginHorizontal="16dp"
          android:layout_marginVertical="2dp"
          android:alpha="0.45"
          android:background="?attr/colorOutlineVariant"
          android:importantForAccessibility="no" />
      </FrameLayout>
      <LinearLayout
        android:id="@+id/search_input_row"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">
        <io.github.lumiagg.gestureevo.gesture.ui.RoundImageTextView
          android:id="@+id/engine_icon"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:src="@drawable/baseline_add_24"
          android:tint="?attr/colorOnSurfaceVariant" />
        <EditText
          android:id="@+id/search_input"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_marginStart="12dp"
          android:layout_weight="1"
          android:background="@android:color/transparent"
          android:ellipsize="none"
          android:gravity="center_vertical"
          android:hint="@string/quick_search_hint"
          android:imeOptions="actionSearch"
          android:inputType="textMultiLine|textCapSentences"
          android:maxLines="2"
          android:scrollbars="none"
          android:singleLine="false"
          android:textColor="?attr/colorOnSurface"
          android:textColorHint="?attr/colorOnSurfaceVariant"
          android:textSize="18sp"
          android:importantForAutofill="no" />
        <ImageView
          android:id="@+id/image_attach_button"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:layout_marginEnd="6dp"
          android:contentDescription="@string/quick_search_add_image"
          android:padding="3dp"
          android:src="@drawable/baseline_image_24"
          android:visibility="visible"
          app:tint="?attr/colorOnSurfaceVariant"
          tools:visibility="visible" />
        <TextView
          android:id="@+id/image_count_badge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginEnd="6dp"
          android:background="@drawable/quick_search_image_badge_bg"
          android:clickable="true"
          android:focusable="true"
          android:minWidth="20dp"
          android:paddingHorizontal="6dp"
          android:paddingVertical="2dp"
          android:textColor="?attr/colorOnPrimaryContainer"
          android:textSize="11sp"
          android:visibility="gone"
          tools:text="2"
          tools:visibility="visible" />
        <ImageView
          android:id="@+id/clear_button"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:padding="3dp"
          android:src="@drawable/clear_all_24px"
          android:visibility="gone"
          app:tint="?attr/colorOnSurfaceVariant"
          tools:visibility="visible"
          android:contentDescription="@string/quick_search_clear_input" />
      </LinearLayout>
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_engine_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:cardPreventCornerOverlap="false">
        <LinearLayout
          android:id="@+id/engine_container"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
          <View
            android:id="@+id/engine_divider"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone" />
          <io.github.lumiagg.gestureevo.search.QuickSearchEnginePager
            android:id="@+id/engine_pager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:paddingHorizontal="4dp"
            android:paddingTop="2dp"
            android:paddingBottom="8dp"
            tools:itemCount="5" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
