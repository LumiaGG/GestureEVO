<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:settingsCardTitle="@string/free_trigger_name_hint"
            app:settingsCardSummary="@string/free_trigger_name_description"
            app:settingsCardExpanded="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/free_trigger_name_hint"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameInputLayout"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/free_trigger_name_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>

        <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:settingsCardTitle="@string/free_trigger_wheel_behavior_title"
            app:settingsCardSummary="@string/free_trigger_wheel_behavior_desc"
            app:settingsCardExpanded="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_shape_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/free_trigger_shape_desc"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <io.github.lumiagg.gestureevo.settings.ui.QuadrantCircleView
                        android:id="@+id/pieConfigQuadrant"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowSummary="@string/free_trigger_mirror_desc"
                    app:settingsRowTitle="@string/free_trigger_mirror_title">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/mirrorSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>

                <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowSummary="@string/free_trigger_keyboard_layer_desc"
                    app:settingsRowTitle="@string/free_trigger_keyboard_layer_title">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/belowKeyboardSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>

                <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowSummary="@string/free_trigger_follow_touch_desc"
                    app:settingsRowTitle="@string/free_trigger_follow_touch_title">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/followTriggerPointSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>

                <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowSummary="@string/free_trigger_feedback_desc"
                    app:settingsRowTitle="@string/free_trigger_feedback_title">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/feedbackSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
            </LinearLayout>
        </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>

        <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:settingsCardTitle="@string/free_trigger_scope_title"
            app:settingsCardSummary="@string/free_trigger_scope_desc"
            app:settingsCardExpanded="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_screen_orientation_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/free_trigger_screen_orientation_desc"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/orientationChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/portraitChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_orientation_portrait" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/landscapeChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_orientation_landscape" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_app_filter_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/free_trigger_app_filter_desc"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/filterChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/blacklistChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_blacklist" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/whitelistChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_whitelist" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
                    android:id="@+id/manageListButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowTitle="@string/free_trigger_manage_list" />
            </LinearLayout>
        </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>

        <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:settingsCardTitle="@string/free_trigger_actions_title"
            app:settingsCardSummary="@string/free_trigger_actions_desc"
            app:settingsCardExpanded="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
                    android:id="@+id/actionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowTitle="@string/free_trigger_set_action" />

                <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
                    android:id="@+id/angleButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowTitle="@string/free_trigger_set_angle" />

                <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
                    android:id="@+id/timeButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:settingsRowTitle="@string/free_trigger_set_time" />

            </LinearLayout>
        </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>

        <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:settingsCardTitle="@string/free_trigger_layout_title"
            app:settingsCardSummary="@string/free_trigger_layout_desc"
            app:settingsCardExpanded="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_position_horizontal"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/xPositionSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:labelBehavior="floating" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_position_vertical"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/yPositionSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="1"
                        app:labelBehavior="floating" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_size_mode_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/sizeModeChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/sizeModeSmallChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_size_mode_small" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/sizeModeMediumChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_size_mode_medium" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/sizeModeLargeChip"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/free_trigger_size_mode_large" />

                    </com.google.android.material.chip.ChipGroup>

                    <TextView
                        android:id="@+id/sizeModeHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_size_width"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/widthSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="1"
                        android:valueTo="100"
                        app:labelBehavior="floating" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_settings_tile_quiet"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/free_trigger_size_height"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/heightSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="1"
                        android:valueFrom="1"
                        android:valueTo="100"
                        app:labelBehavior="floating" />
                </LinearLayout>
            </LinearLayout>
        </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="@string/free_trigger_delete"
                app:icon="@drawable/ic_delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/free_trigger_cancel" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
