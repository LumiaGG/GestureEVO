<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/guideRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_bar_height">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/toolbarLayout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:toolbarId="@+id/toolbar">
      <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/guide_title" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:id="@+id/guideScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
      android:id="@+id/guideContent"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/settings_card_spacing"
      android:paddingTop="16dp"
      android:paddingEnd="@dimen/settings_card_spacing"
      android:paddingBottom="16dp">
      <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:accessibilityLiveRegion="polite"
        android:text="@string/guide_loading"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
      <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/guideProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="3"
        android:progress="0" />
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/accessibilityCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/guide_accessibility_title"
        app:settingsCardSummary="@string/guide_accessibility_summary"
        app:settingsCardExpanded="true">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="4dp"
          android:paddingEnd="12dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/accessibilityButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingsRowTitle="@string/guide_accessibility_button" />
          <TextView
            android:id="@+id/accessibilityStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_loading"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/gestureCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/quick_setup_gesture_card_title"
        app:settingsCardSummary="@string/quick_setup_gesture_card_summary"
        app:settingsCardExpanded="true">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="4dp"
          android:paddingEnd="12dp"
          android:paddingBottom="12dp">
          <include
            android:id="@+id/gestureSetup"
            layout="@layout/guide_gesture_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
          <TextView
            android:id="@+id/triggerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_loading"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <TextView
            android:id="@+id/actionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_loading"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/wheelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/quick_setup_wheel_card_title"
        app:settingsCardSummary="@string/quick_setup_wheel_card_summary"
        app:settingsCardExpanded="true">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="4dp"
          android:paddingEnd="12dp"
          android:paddingBottom="12dp">
          <include
            android:id="@+id/wheelSetup"
            layout="@layout/guide_wheel_setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/backgroundCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/guide_background_title"
        app:settingsCardSummary="@string/guide_background_summary"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="4dp"
          android:paddingEnd="12dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/batteryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingsRowTitle="@string/guide_battery_button" />
          <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_loading"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/autoStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:settingsRowTitle="@string/guide_auto_start_button" />
          <TextView
            android:id="@+id/autoStartStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_manual_check"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/optionalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/guide_optional_title"
        app:settingsCardSummary="@string/guide_optional_summary"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingStart="12dp"
          android:paddingTop="4dp"
          android:paddingEnd="12dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/notificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:settingsRowTitle="@string/guide_notification_button"
            app:settingsRowSummary="@string/guide_notification_summary" />
          <TextView
            android:id="@+id/notificationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_optional"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/notificationAccessButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:settingsRowTitle="@string/guide_notification_access_button"
            app:settingsRowSummary="@string/guide_notification_access_summary" />
          <TextView
            android:id="@+id/notificationAccessStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_optional"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/contactsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:settingsRowTitle="@string/guide_contacts_button"
            app:settingsRowSummary="@string/guide_contacts_summary" />
          <TextView
            android:id="@+id/contactsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_optional"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/advancedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:settingsRowTitle="@string/guide_advanced_button"
            app:settingsRowSummary="@string/guide_advanced_summary" />
          <TextView
            android:id="@+id/advancedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:text="@string/guide_optional"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <TextView
        android:id="@+id/statusMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/guide_loading"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/finishButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:enabled="false"
        android:minHeight="48dp"
        android:text="@string/guide_finish" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/skipButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:minHeight="48dp"
        android:text="@string/guide_skip" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
