<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/pinPoolRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clipChildren="false"
  android:clipToPadding="false">
  <com.google.android.material.card.MaterialCardView
    android:id="@+id/cardContainer"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:layout_gravity="end|center_vertical"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:padding="8dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
          android:id="@+id/categorySwitcher"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:background="?attr/selectableItemBackground"
          android:clickable="true"
          android:contentDescription="@string/pin_pool_switch_category"
          android:focusable="true"
          android:gravity="center_vertical"
          android:minHeight="36dp"
          android:orientation="horizontal"
          android:paddingEnd="8dp"
          android:paddingStart="0dp">
          <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/pin_pool_title"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface" />
          <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/categorySwitchIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/baseline_unfold_more_24"
            android:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/closeButton"
          android:layout_width="28dp"
          android:layout_height="28dp"
          android:background="?attr/selectableItemBackgroundBorderless"
          android:padding="4dp"
          android:src="@drawable/baseline_clear_24"
          android:tint="?attr/colorOnSurfaceVariant" />
      </LinearLayout>
      <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/pin_pool_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
          android:id="@+id/pinRecycler"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:clipToPadding="false"
          android:overScrollMode="never" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/clearButton"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|center"
          android:text="@string/pin_pool_clear_action"
          android:textColor="?attr/colorOnSurface"
          app:backgroundTint="?attr/colorSurfaceContainer"
          app:icon="@drawable/baseline_clear_24"
          app:iconPadding="8dp"
          app:iconTint="?attr/colorOnSurface" />
      </FrameLayout>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</FrameLayout>
