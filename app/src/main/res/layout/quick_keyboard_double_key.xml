<androidx.constraintlayout.widget.ConstraintLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent">
  <com.google.android.material.textview.MaterialTextView
    android:id="@+id/inputPrompt"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toTopOf="@id/firstLine" />
  <LinearLayout
    android:id="@+id/firstLine"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/inputPrompt"
    app:layout_constraintBottom_toTopOf="@id/secondLine"
    app:layout_constraintVertical_weight="1">
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="Q"
      app:rightLetterText="W"
      app:topLetterText="1" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="E"
      app:rightLetterText="R"
      app:topLetterText="2" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="T"
      app:rightLetterText="Y"
      app:topLetterText="3" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="U"
      app:rightLetterText="I"
      app:topLetterText="4" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="O"
      app:rightLetterText="P"
      app:topLetterText="5" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/secondLine"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/firstLine"
    app:layout_constraintBottom_toTopOf="@id/thirdLine"
    app:layout_constraintVertical_weight="1">
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="A"
      app:rightLetterText="S"
      app:topLetterText="6" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="D"
      app:rightLetterText="F"
      app:topLetterText="7" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="G"
      app:rightLetterText="H"
      app:topLetterText="8" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="J"
      app:rightLetterText="K"
      app:topLetterText="9" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText="L"
      app:topLetterText="0" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/thirdLine"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/secondLine"
    app:layout_constraintBottom_toTopOf="@id/fourthLine"
    app:layout_constraintVertical_weight="1">
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.5"
      app:leftLetterText="-" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:topLetterText=" "
      app:leftLetterText="Z"
      app:rightLetterText="X" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:topLetterText=" "
      app:leftLetterText="C"
      app:rightLetterText="V" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:topLetterText=" "
      app:leftLetterText="B"
      app:rightLetterText="N" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.7"
      app:topLetterText=" "
      app:leftLetterText="M" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardFuncView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.7"
      app:func="BACKSPACE"
      app:icon="@drawable/baseline_backspace_24" />
  </LinearLayout>
  <LinearLayout
    android:id="@+id/fourthLine"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:orientation="horizontal"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/thirdLine"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintVertical_weight="1">
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardFuncView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.3"
      app:func="SETTINGS"
      app:icon="@drawable/baseline_settings_24" />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardLetterView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      app:leftLetterText=" " />
    <io.github.lumiagg.gestureevo.quick.ui.KeyboardFuncView
      style="@style/Widget.DoubleKeyView"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="0.4"
      app:func="ENTER"
      app:icon="@drawable/baseline_arrow_right_alt_24" />
  </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
