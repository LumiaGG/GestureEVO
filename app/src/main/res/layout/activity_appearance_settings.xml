<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_bar_height">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/toolbar_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:toolbarId="@+id/toolbar">
      <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/appearance_settings_title" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:id="@+id/appearanceScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="@dimen/settings_card_spacing"
      android:paddingVertical="16dp">
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/languageCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_language_title"
        app:settingsCardSummary="@string/appearance_settings_language_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/languageDropdown"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/appearance_settings_language_hint">
            <AutoCompleteTextView
              android:id="@+id/languageAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none"
              android:hint="@string/appearance_settings_language_hint" />
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/globalAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_global_title"
        app:settingsCardSummary="@string/appearance_settings_global_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dynamicColorSchemeDropdown"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/appearance_settings_color_scheme_hint">
            <AutoCompleteTextView
              android:id="@+id/dynamicColorSchemeAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none"
              android:hint="@string/appearance_settings_color_scheme_hint" />
          </com.google.android.material.textfield.TextInputLayout>
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/iconPackDropdown"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/appearance_settings_icon_pack_hint">
            <AutoCompleteTextView
              android:id="@+id/iconPackAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none"
              android:hint="@string/appearance_settings_icon_pack_hint" />
          </com.google.android.material.textfield.TextInputLayout>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/appIconOverrideButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_icon_override_button"
            app:settingsRowSummary="@string/appearance_settings_icon_override_summary" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_settings_global_icon_corner"
                android:textStyle="bold" />
              <TextView
                android:id="@+id/icon_image_round_percent_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appearance_settings_global_icon_corner_default"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.slider.Slider
              android:id="@+id/icon_image_round_percent_slider"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:valueFrom="0"
              android:valueTo="1"
              app:labelBehavior="floating" />
          </LinearLayout>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/pointerAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_pointer_title"
        app:settingsCardSummary="@string/appearance_settings_pointer_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/pointer_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_pointer_color"
            app:settingsRowSummary="@string/appearance_settings_pointer_color_summary"
            app:settingsRowSwatch="true" />
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/pointerShapeDropdown"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/appearance_settings_pointer_shape">
            <AutoCompleteTextView
              android:id="@+id/pointerShapeAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none" />
          </com.google.android.material.textfield.TextInputLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_settings_pointer_size"
                android:textStyle="bold" />
              <TextView
                android:id="@+id/pointerSizeValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="@string/appearance_settings_pointer_size_summary"
              android:textColor="?android:textColorSecondary" />
            <com.google.android.material.slider.Slider
              android:id="@+id/pointerSizeSlider"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:stepSize="1"
              android:valueFrom="16"
              android:valueTo="48"
              android:value="30" />
          </LinearLayout>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:id="@+id/pointerClickFeedbackRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_pointer_click_feedback"
            app:settingsRowSummary="@string/appearance_settings_pointer_click_feedback_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/pointerClickFeedbackSwitch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/wheelAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_wheel_title"
        app:settingsCardSummary="@string/appearance_settings_wheel_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_wheel_background_blur"
            app:settingsRowSummary="@string/appearance_settings_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/wheel_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/wheel_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_wheel_color"
            app:settingsRowSummary="@string/appearance_settings_wheel_color_summary"
            app:settingsRowSwatch="true" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/searchAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_search_title"
        app:settingsCardSummary="@string/appearance_settings_search_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_search_background_blur"
            app:settingsRowSummary="@string/appearance_settings_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_search_card_background_blur"
            app:settingsRowSummary="@string/appearance_settings_card_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/search_card_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/search_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_search_color"
            app:settingsRowSummary="@string/appearance_settings_search_color_summary"
            app:settingsRowSwatch="true" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/keyboardAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_keyboard_title"
        app:settingsCardSummary="@string/appearance_settings_keyboard_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_keyboard_background_blur"
            app:settingsRowSummary="@string/appearance_settings_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/keyboard_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_keyboard_card_background_blur"
            app:settingsRowSummary="@string/appearance_settings_card_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/keyboard_card_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/pinPoolAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_pin_pool_title"
        app:settingsCardSummary="@string/appearance_settings_pin_pool_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_pin_pool_background_blur"
            app:settingsRowSummary="@string/appearance_settings_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/pin_pool_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_pin_pool_card_background_blur"
            app:settingsRowSummary="@string/appearance_settings_card_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/pin_pool_card_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/screenContentAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_screen_content_title"
        app:settingsCardSummary="@string/appearance_settings_screen_content_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_screen_content_background_blur"
            app:settingsRowSummary="@string/appearance_settings_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/screen_content_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_screen_content_card_background_blur"
            app:settingsRowSummary="@string/appearance_settings_card_background_blur_summary">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/screen_content_card_background_blur_switch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/fluidFeedbackAppearanceCard"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:settingsCardTitle="@string/appearance_settings_fluid_title"
        app:settingsCardSummary="@string/appearance_settings_fluid_description"
        app:settingsCardExpanded="false"
        android:layout_height="wrap_content">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/fluid_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_fluid_color"
            app:settingsRowSummary="@string/appearance_settings_fluid_color_summary"
            app:settingsRowSwatch="true" />
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/fluidStyleDropdown"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/appearance_settings_fluid_style">
            <AutoCompleteTextView
              android:id="@+id/fluidStyleAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none"
              android:hint="@string/appearance_settings_fluid_style" />
          </com.google.android.material.textfield.TextInputLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_settings_fluid_size"
                android:textStyle="bold" />
              <TextView
                android:id="@+id/fluid_size_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="@string/appearance_settings_fluid_size_summary"
              android:textColor="?android:textColorSecondary" />
            <com.google.android.material.slider.Slider
              android:id="@+id/fluid_size_slider"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:stepSize="0.05"
              android:valueFrom="0.75"
              android:valueTo="1.5"
              app:labelBehavior="floating" />
          </LinearLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_marginTop="8dp">
            <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center_vertical"
              android:orientation="horizontal">
              <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/appearance_settings_fluid_stroke"
                android:textStyle="bold" />
              <TextView
                android:id="@+id/fluid_stroke_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorPrimary" />
            </LinearLayout>
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:text="@string/appearance_settings_fluid_stroke_summary"
              android:textColor="?android:textColorSecondary" />
            <com.google.android.material.slider.Slider
              android:id="@+id/fluid_stroke_slider"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:stepSize="0.5"
              android:valueFrom="0"
              android:valueTo="6"
              app:labelBehavior="floating" />
          </LinearLayout>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/fluid_stroke_color_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/appearance_settings_fluid_stroke_color"
            app:settingsRowSummary="@string/appearance_settings_fluid_stroke_color_summary"
            app:settingsRowSwatch="true" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
