<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_bar_height">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/toolbar_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:toolbarId="@+id/toolbar">
      <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/action_view_settings_title" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:id="@+id/contentScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingBottom="20dp">
      <com.google.android.material.card.MaterialCardView
        android:id="@+id/debugNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:cardBackgroundColor="?attr/colorErrorContainer"
        app:cardElevation="0dp"
        app:cardCornerRadius="@dimen/settings_card_corner_radius"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="top"
          android:orientation="horizontal">
          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="4dp"
            android:paddingBottom="16dp"
            android:text="@string/action_view_settings_debug_notice"
            android:textColor="?attr/colorOnErrorContainer" />
          <ImageButton
            android:id="@+id/closeDebugNoticeButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_view_settings_notice_close"
            android:padding="12dp"
            android:src="@drawable/baseline_clear_24"
            app:tint="?attr/colorOnErrorContainer" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/actionItemListTagsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/debugNotice"
        app:settingsCardTitle="@string/action_view_settings_groups_title"
        app:settingsCardSummary="@string/action_view_settings_groups_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/selectPieGroupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_current_group_title">
            <TextView
              android:id="@+id/currentPieGroupName"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/action_view_settings_current_group_not_selected" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/addPieGroupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_add_group"
            app:settingsRowSummary="@string/action_view_settings_add_group_summary" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/managePieGroupButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_manage"
            app:settingsRowSummary="@string/action_view_settings_manage_summary" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/previewTriggerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@+id/actionItemListTagsCard"
        app:settingsCardTitle="@string/action_view_settings_preview_title"
        app:settingsCardSummary="@string/action_view_settings_preview_summary"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_view_settings_preview_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_view_settings_preview_summary"
            android:textColor="?android:textColorSecondary" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/previewTriggerButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_preview_trigger_title">
            <TextView
              android:id="@+id/previewTriggerName"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/previewPieButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_preview_button"
            app:settingsRowSummary="@string/action_view_preview_button_summary" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/primaryPieCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/previewTriggerCard"
        app:settingsCardTitle="@string/action_view_settings_primary_title"
        app:settingsCardSummary="@string/action_view_settings_primary_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_view_settings_primary_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/action_view_settings_primary_description"
            android:textColor="?android:textColorSecondary" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/pieContentConfigEntry"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/action_view_settings_content_entry_title"
              app:settingsRowSummary="@string/action_view_settings_content_entry_summary" />
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/pieStyleConfigEntry"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/action_view_settings_main_style_entry_title"
              app:settingsRowSummary="@string/action_view_settings_main_style_entry_summary" />
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/pieSubStyleConfigEntry"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/action_view_settings_sub_style_entry_title"
              app:settingsRowSummary="@string/action_view_settings_sub_style_entry_summary" />
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/pieRecentBlackListButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/action_view_settings_blacklist_manage"
              app:settingsRowSummary="@string/action_view_settings_blacklist_description" />
          </LinearLayout>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/miscCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/primaryPieCard"
        app:settingsCardTitle="@string/action_view_settings_misc_title"
        app:settingsCardSummary="@string/action_view_settings_misc_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_view_settings_misc_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <com.google.android.material.slider.Slider
            android:id="@+id/centerWarpOffsetSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:valueFrom="0"
            android:valueTo="200"
            android:visibility="gone"
            app:labelBehavior="floating" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_selected_hint">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/selectedHintIconSwitch"
              android:checked="true"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_show_anim">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/mainViewShowAnimSwitch"
              android:checked="true"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_show_vibrate">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/mainViewShowVibrateSwitch"
              android:checked="true"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/action_view_settings_disable_all_wheel_vibrate">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/disableAllWheelVibrateSwitch"
              android:checked="false"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/externalCallCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/miscCard"
        app:settingsCardTitle="@string/external_call_title"
        app:settingsCardSummary="@string/external_call_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/external_call_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/external_call_description"
            android:textColor="?android:textColorSecondary" />
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_tile_quiet"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp">
            <TextView
              android:id="@+id/externalCallSummary"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textAppearance="?attr/textAppearanceBodySmall"
              android:textColor="?attr/colorOnSurfaceVariant" />
            <TextView
              android:id="@+id/externalCallLinkTitle"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="@string/external_call_link_title"
              android:textAppearance="?attr/textAppearanceTitleSmall"
              android:textColor="?attr/colorOnSurface" />
            <TextView
              android:id="@+id/externalCallLink"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:textAppearance="?attr/textAppearanceBodyMedium"
              android:textColor="?attr/colorPrimary"
              android:textIsSelectable="true" />
          </LinearLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/externalCallConfigButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/external_call_config_button"
              app:settingsRowSummary="@string/external_call_config_summary" />
            <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
              android:id="@+id/externalCallCopyButton"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              app:settingsRowTitle="@string/external_call_copy_button"
              app:settingsRowSummary="@string/external_call_copy_summary"
              app:settingsRowTrailingIcon="@drawable/ic_baseline_content_copy_24" />
          </LinearLayout>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
