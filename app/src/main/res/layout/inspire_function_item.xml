<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Theme.participleItemBg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="15dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/functionLL"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/cancelSelect"
                style="@style/Theme.participleItem"
                android:layout_width="78dp"
                android:layout_height="28dp"
                android:layout_margin="5dp"
                android:foreground="?attr/selectableItemBackground"
                android:padding="4dp"
                android:src="@drawable/ic_baseline_cancel_24"
                android:tint="@color/grey8"
                app:round="10dp" />

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/checkSelect"
                style="@style/Theme.participleItem"
                android:layout_width="78dp"
                android:layout_height="28dp"
                android:layout_margin="5dp"
                android:foreground="?attr/selectableItemBackground"
                android:padding="4dp"
                android:src="@drawable/baseline_check_24"
                android:tint="@color/grey8"
                app:round="10dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>


        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/functionDivider"
            style="@style/Theme.participleItem"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:background="@color/grey8"
            app:round="100dp" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/editImage"
                style="@style/Theme.participleItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:contentDescription="@string/inspire_image_edit_title"
                android:foreground="?attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/baseline_edit_24"
                android:tint="@color/grey8"
                app:round="100dp" />

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/shareImage"
                style="@style/Theme.participleItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:foreground="?attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/ic_baseline_share_24"
                android:tint="@color/grey8"
                app:round="100dp" />

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/pinImage"
                style="@style/Theme.participleItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:foreground="?attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/baseline_push_pin_24"
                android:tint="@color/grey8"
                app:round="100dp" />

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/saveImage"
                style="@style/Theme.participleItem"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_margin="5dp"
                android:foreground="?attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/baseline_save_24"
                android:tint="@color/grey8"
                app:round="100dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
