    <androidx.core.widget.NestedScrollView android:id="@+id/backgroundStabilityScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" app:layout_behavior="@string/appbar_scrolling_view_behavior">
