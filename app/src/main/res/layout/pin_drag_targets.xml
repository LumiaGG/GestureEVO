<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:padding="8dp">

  <com.google.android.material.card.MaterialCardView
    android:id="@+id/panel"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardPreventCornerOverlap="false"
    app:strokeWidth="1dp">

    <LinearLayout
      android:id="@+id/tools"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="6dp">

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cancelTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/pin_drag_send_cancel"
        android:importantForAccessibility="yes"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <TextView
          android:id="@+id/cancelLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:importantForAccessibility="no"
          android:minWidth="72dp"
          android:minHeight="56dp"
          android:padding="12dp"
          android:text="@string/pin_drag_send_cancel"
          android:textAppearance="?attr/textAppearanceTitleSmall"
          android:textColor="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/cancelIcon"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:importantForAccessibility="no"
          android:scaleType="center"
          android:visibility="gone"
          app:srcCompat="@drawable/baseline_clear_24"
          app:tint="?attr/colorOnSurface" />
      </com.google.android.material.card.MaterialCardView>

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/pinTarget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/pin_drag_send_repin"
        android:importantForAccessibility="yes"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <TextView
          android:id="@+id/pinLabel"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:importantForAccessibility="no"
          android:minWidth="72dp"
          android:minHeight="56dp"
          android:padding="12dp"
          android:text="@string/pin_drag_send_repin"
          android:textAppearance="?attr/textAppearanceTitleSmall"
          android:textColor="?attr/colorOnSurface" />

        <androidx.appcompat.widget.AppCompatImageView
          android:id="@+id/pinIcon"
          android:layout_width="48dp"
          android:layout_height="48dp"
          android:importantForAccessibility="no"
          android:scaleType="center"
          android:visibility="gone"
          app:srcCompat="@drawable/baseline_push_pin_24"
          app:tint="?attr/colorOnSurface" />
      </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
</FrameLayout>
