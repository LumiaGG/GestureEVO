<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardCornerRadius="15dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/functionLL"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/edit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/baseline_edit_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/share"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/ic_baseline_share_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/pin"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/baseline_push_pin_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/transition"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/ic_baseline_g_translate_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/copySelected"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/ic_baseline_content_copy_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/openUrl"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/ic_baseline_insert_link_24"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/sendToEVO"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="5dp"
            android:foreground="?attr/selectableItemBackground"
            android:padding="5dp"
            android:src="@drawable/search_24px"
            android:tint="?attr/colorPrimary"
            app:round="100dp" />


    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.cardview.widget.CardView>
