<?xml version='1.0' encoding='utf-8'?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true">
    <com.google.android.material.appbar.AppBarLayout android:layout_width="match_parent" android:layout_height="@dimen/app_bar_height">
        <com.google.android.material.appbar.CollapsingToolbarLayout android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" app:layout_scrollFlags="scroll|exitUntilCollapsed" app:toolbarId="@+id/toolbar">
            <androidx.appcompat.widget.Toolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:layout_collapseMode="pin" app:title="@string/external_action_settings_title" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/externalActionScrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/settings_card_spacing" android:paddingVertical="16dp">
            <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard android:id="@+id/externalActionEditorCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/settings_card_spacing" app:cardUseCompatPadding="false" app:settingsCardTitle="@string/external_action_editor_title" app:settingsCardSummary="@string/external_action_editor_description" app:settingsCardExpanded="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/external_action_editor_title" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/external_action_editor_description" android:textColor="?android:textColorSecondary" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow android:id="@+id/newRecordButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:settingsRowTitle="@string/external_action_open_create_button" app:settingsRowSummary="@string/external_action_open_create_summary" />
                        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow android:id="@+id/openExternalWheelButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:settingsRowTitle="@string/external_action_open_wheel_button" app:settingsRowSummary="@string/external_action_open_wheel_summary" />
                    </LinearLayout>
                </LinearLayout>
            </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
            <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard android:id="@+id/externalActionHistoryCard" android:layout_width="match_parent" android:layout_height="wrap_content" app:settingsCardTitle="@string/external_action_history_title" app:settingsCardSummary="@string/external_action_history_description" app:settingsCardExpanded="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/external_action_history_title" android:textSize="16sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/external_action_history_description" android:textColor="?android:textColorSecondary" />
                    <TextView android:id="@+id/emptyHistoryText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/external_action_history_empty" android:textColor="?android:textColorSecondary" />
                    <LinearLayout android:id="@+id/recordsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
                </LinearLayout>
            </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>