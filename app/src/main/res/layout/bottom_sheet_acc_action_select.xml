<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/title_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="4dp"
            android:paddingVertical="12dp"
            android:text="@string/acc_action_select_title"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="1"
            app:settingsRowTitle="@string/acc_action_select_back" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_recents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="3"
            app:settingsRowTitle="@string/acc_action_select_recents" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_quick_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="5"
            app:settingsRowTitle="@string/acc_action_select_quick_settings" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="4"
            app:settingsRowTitle="@string/acc_action_select_notifications" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="2"
            app:settingsRowTitle="@string/acc_action_select_home" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_take_screenshot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="9"
            app:settingsRowTitle="@string/acc_action_select_screenshot" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_lock_screen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="8"
            app:settingsRowTitle="@string/acc_action_select_lock_screen" />

        <io.github.lumiagg.gestureevo.settings.ui.SettingsNavRow
            android:id="@+id/btn_action_power_dialog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:tag="6"
            app:settingsRowTitle="@string/acc_action_select_power_dialog" />
    </LinearLayout>
</ScrollView>
