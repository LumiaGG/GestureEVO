<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/screenshot_preview_container"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <androidx.constraintlayout.utils.widget.ImageFilterView
            android:id="@+id/screenshot_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />

        <io.github.lumiagg.gestureevo.inspire.ui.OcrImageTextOverlayView
            android:id="@+id/ocr_image_text_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/image_selection_text_preview_container"
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/image_selection_text_preview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:maxWidth="280dp"
                android:minWidth="72dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                tools:text="用户真正选中的文字" />

        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/image_selection_action_bar_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:clipChildren="false"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Material3.CardView.Filled"
            android:layout_width="42dp"
            android:layout_height="35dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="2dp"
            app:cardElevation="0dp">

            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/btn_image_text_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackground"
                android:padding="7dp"
                android:src="@drawable/ic_image_text_expand_24"
                android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <io.github.lumiagg.gestureevo.inspire.ui.InspireActionButtonsRow
            android:id="@+id/image_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/scanQR"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/baseline_qr_code_scanner_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/btn_share"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/ic_baseline_share_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/btn_pin_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/baseline_push_pin_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/btn_save_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/baseline_save_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
        </io.github.lumiagg.gestureevo.inspire.ui.InspireActionButtonsRow>

        <LinearLayout
            android:id="@+id/text_action_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/openUrl"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/ic_baseline_insert_link_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/btn_reselect"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/baseline_refresh_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="2"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:padding="2dp">

                    <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btn_mode_ocr"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/inspire_mode_selector_left"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/inspire_mode_ocr"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/inspire_mode_selector_text" />

                    <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/btn_mode_accessibility"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/inspire_mode_selector_right"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="@string/inspire_mode_accessibility"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/inspire_mode_selector_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="0dp"
                android:layout_height="35dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                app:cardElevation="0dp">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/selectAll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/selectableItemBackground"
                    android:padding="7dp"
                    android:src="@drawable/baseline_select_all_24"
                    android:tint="?attr/colorPrimary" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bigBangLayoutNestedScroll"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:scrollbars="none">

        <io.github.lumiagg.gestureevo.inspire.ui.BigBangView
            android:id="@+id/bigBangLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:importantForAccessibility="no" />

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
