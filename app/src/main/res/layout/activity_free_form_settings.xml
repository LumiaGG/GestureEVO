<androidx.coordinatorlayout.widget.CoordinatorLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">
  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_bar_height">
    <com.google.android.material.appbar.CollapsingToolbarLayout
      android:id="@+id/toolbar_layout"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fitsSystemWindows="true"
      app:layout_scrollFlags="scroll|exitUntilCollapsed"
      app:toolbarId="@+id/toolbar">
      <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_collapseMode="pin"
        app:title="@string/freeform_settings_title" />
    </com.google.android.material.appbar.CollapsingToolbarLayout>
  </com.google.android.material.appbar.AppBarLayout>
  <androidx.core.widget.NestedScrollView
    android:id="@+id/freeFormScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/main"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      tools:context=".settings.FreeFormSettingsActivity">
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/directionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toTopOf="parent"
        app:settingsCardTitle="@string/freeform_settings_direction_title"
        app:settingsCardSummary="@string/freeform_settings_direction_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/freeform_settings_direction_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/freeform_settings_direction_description"
            android:textColor="?android:textColorSecondary" />
          <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/directionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">
            <com.google.android.material.button.MaterialButton
              android:id="@+id/directionButtonPortrait"
              style="?attr/materialButtonOutlinedStyle"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/freeform_settings_direction_portrait" />
            <com.google.android.material.button.MaterialButton
              android:id="@+id/directionButtonLandscape"
              style="?attr/materialButtonOutlinedStyle"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:text="@string/freeform_settings_direction_landscape" />
          </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/dropdownCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/directionCard"
        app:settingsCardTitle="@string/freeform_settings_mode_title"
        app:settingsCardSummary="@string/freeform_settings_mode_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/freeform_settings_mode_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/freeform_settings_mode_description"
            android:textColor="?android:textColorSecondary" />
          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dropdownMenu"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <AutoCompleteTextView
              android:id="@+id/dropdownAutoComplete"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:inputType="none"
              android:hint="@string/freeform_settings_mode_title" />
          </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard
        android:id="@+id/sizeCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/settings_card_spacing"
        android:layout_marginTop="@dimen/settings_card_spacing"
        app:layout_constraintTop_toBottomOf="@+id/dropdownCard"
        app:settingsCardTitle="@string/freeform_settings_size_title"
        app:settingsCardSummary="@string/freeform_settings_size_description"
        app:settingsCardExpanded="false">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="12dp"
          android:paddingTop="4dp"
          android:paddingBottom="12dp">
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/freeform_settings_size_title"
            android:textSize="16sp"
            android:textStyle="bold" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/freeform_settings_size_description"
            android:textColor="?android:textColorSecondary" />
          <TextView
            android:id="@+id/sizeInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_settings_tile_quiet"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:text="@string/freeform_settings_size_info_default"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurface" />
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/freeform_settings_size_enable">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/enableSizeChange"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow
            android:id="@+id/followTriggerSideRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:settingsRowTitle="@string/freeform_settings_follow_trigger_side"
            app:settingsRowSummary="@string/freeform_settings_follow_trigger_side_desc">
            <com.google.android.material.materialswitch.MaterialSwitch
              android:id="@+id/followTriggerSideSwitch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content" />
          </io.github.lumiagg.gestureevo.settings.ui.SettingsSwitchRow>
          <com.google.android.material.button.MaterialButton
            android:id="@+id/resetSizeButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/freeform_settings_size_reset" />
        </LinearLayout>
      </io.github.lumiagg.gestureevo.settings.ui.SettingsSectionCard>
      <Space
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintTop_toBottomOf="@id/sizeCard" />
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>
  <io.github.lumiagg.gestureevo.settings.ui.ResizableRectangleView
    android:id="@+id/resizableRectangle"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="10dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
