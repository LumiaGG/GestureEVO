<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/quick_setup_side"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <com.google.android.material.button.MaterialButtonToggleGroup
    android:id="@+id/sideGroup"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    app:checkedButton="@id/sideRight"
    app:selectionRequired="true"
    app:singleSelection="true">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/sideLeft"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:minHeight="48dp"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:text="@string/quick_setup_left"
      android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/sideBoth"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:minHeight="48dp"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:text="@string/quick_setup_both"
      android:textAllCaps="false" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/sideRight"
      style="?attr/materialButtonOutlinedStyle"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:minWidth="0dp"
      android:minHeight="48dp"
      android:paddingStart="4dp"
      android:paddingEnd="4dp"
      android:text="@string/quick_setup_right"
      android:textAllCaps="false" />
  </com.google.android.material.button.MaterialButtonToggleGroup>
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/quick_setup_position"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <TextView
    android:id="@+id/positionValue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.slider.Slider
    android:id="@+id/positionSlider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/quick_setup_position"
    android:stepSize="5"
    android:value="55"
    android:valueFrom="10"
    android:valueTo="90"
    app:labelBehavior="floating" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/quick_setup_height"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <TextView
    android:id="@+id/heightValue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.slider.Slider
    android:id="@+id/heightSlider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/quick_setup_height"
    android:stepSize="10"
    android:value="100"
    android:valueFrom="40"
    android:valueTo="200"
    app:labelBehavior="floating" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/quick_setup_gestures"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <LinearLayout
    android:id="@+id/gestureRows"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/quick_setup_wheel_inset"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <TextView
    android:id="@+id/wheelInsetValue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.slider.Slider
    android:id="@+id/wheelInsetSlider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/quick_setup_wheel_inset"
    android:stepSize="5"
    android:value="30"
    android:valueFrom="0"
    android:valueTo="120" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="@string/quick_setup_wheel_radius"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <TextView
    android:id="@+id/wheelRadiusValue"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.slider.Slider
    android:id="@+id/wheelRadiusSlider"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:contentDescription="@string/quick_setup_wheel_radius"
    android:stepSize="5"
    android:value="130"
    android:valueFrom="80"
    android:valueTo="200" />
  <TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/quick_setup_wheel"
    android:textAppearance="?attr/textAppearanceTitleSmall" />
  <com.google.android.material.button.MaterialButton
    android:id="@+id/editWheelButton"
    style="?attr/materialButtonOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="48dp"
    android:text="@string/quick_setup_edit_wheel"
    app:icon="@drawable/baseline_pie_chart_24" />
  <com.google.android.material.button.MaterialButton
    android:id="@+id/resetDefaultsButton"
    style="@style/Widget.Material3.Button.TextButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="48dp"
    android:text="@string/quick_setup_reset" />
  <TextView
    android:id="@+id/quickSetupMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:accessibilityLiveRegion="polite"
    android:text="@string/quick_setup_unsaved"
    android:textAppearance="?attr/textAppearanceBodyMedium"
    android:textColor="?attr/colorOnSurfaceVariant" />
  <com.google.android.material.button.MaterialButton
    android:id="@+id/applyQuickSetupButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:minHeight="48dp"
    android:text="@string/quick_practice_start" />
</LinearLayout>
